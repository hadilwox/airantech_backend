APP_NAME=airantech
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local: http://localhost:8000
# Production: https://api.airanacademy.ir
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Local: debug is fine. Production: use "error" so routine warnings don't
# fill the log, and NEVER re-enable APP_DEBUG in production (it leaks
# stack traces, file paths and env values in error responses).
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=academy
DB_USERNAME=academy_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Local: localhost
SESSION_DOMAIN=localhost
# Production (frontend and API on subdomains of the same root domain, e.g.
# app.airanacademy.ir / api.airanacademy.ir): the leading dot shares the
# session cookie across all subdomains of airanacademy.ir.
#   SESSION_DOMAIN=.airanacademy.ir
#   SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE stays "lax" even cross-subdomain: app.* and api.* share
# the same registrable domain, so browsers treat them as "same-site" for
# SameSite purposes. Only switch to "none" if the frontend ever moves to an
# entirely different domain (and then SESSION_SECURE_COOKIE=true is required).
SESSION_SAME_SITE=lax

# SPA (Vue) auth — Sanctum stateful cookie auth. Never token/localStorage auth.
# Local:
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost,127.0.0.1
# Production:
#   FRONTEND_URL=https://app.airanacademy.ir
#   SANCTUM_STATEFUL_DOMAINS=app.airanacademy.ir

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Local: database is fine with `php artisan queue:work` running, or left
# undispatched since no jobs exist yet. Production on shared hosting without
# a persistent queue worker process: use QUEUE_CONNECTION=sync instead.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
